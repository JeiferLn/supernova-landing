---
import {
  ChartColumn,
  Key,
  Shield,
  Webhook,
  FlaskConical,
} from "@lucide/astro";

const infrastructureFeatures = [
  {
    title: "Claves API al instante",
    description:
      "Genera claves de producción y pruebas directamente desde tu panel.",
    icon: Key,
  },
  {
    title: "Webhooks en tiempo real",
    description:
      "Recibe notificaciones instantáneas sobre eventos de pago.",
    icon: Webhook,
  },
  {
    title: "Entorno sandbox completo",
    description:
      "Simula pagos y validaciones antes de producción.",
    icon: FlaskConical,
  },
];

const securityItems = [
  "Validación 3D Secure 2",
  "Monitorización de patrones sospechosos",
  "Gestión de listas de riesgo",
  "Configuración personalizada de reglas",
];

const analyticsItems = [
  "Ingresos en tiempo real",
  "Tasa de aprobación",
  "Historial detallado",
  "Exportación de reportes",
];
---

<section
  class="my-16 lg:my-16 px-6 lg:px-16 max-w-[1440px] mx-auto w-full"
  aria-labelledby="features-heading"
>
  <div class="flex flex-col gap-6 text-center mb-16">
    <h2
      id="features-heading"
      class="text-slate-900 text-3xl font-black tracking-tight"
    >
      Infraestructura lista para desarrollar
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
    {
      infrastructureFeatures.map((feature) => {
        const Icon = feature.icon;
        return (
          <article
            class="group flex flex-col p-8 rounded-2xl bg-slate-50 hover:bg-white border border-transparent hover:border-slate-200 hover:shadow-xl transition-all duration-300"
          >
            <div
              class="mb-6 flex size-12 shrink-0 items-center justify-center rounded-lg bg-[#040066]/10 text-[#040066]"
            >
              <Icon class="size-6" />
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-3">
              {feature.title}
            </h3>
            <p class="text-slate-600 leading-relaxed">
              {feature.description}
            </p>
          </article>
        );
      })
    }
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <article
      class="flex flex-col p-8 rounded-2xl bg-slate-50 hover:bg-white border border-transparent hover:border-slate-200 hover:shadow-xl transition-all duration-300"
    >
      <div
        class="mb-6 flex size-12 shrink-0 items-center justify-center rounded-lg bg-[#040066]/10 text-[#040066]"
      >
        <Shield class="size-6" />
      </div>
      <h3 class="text-xl font-bold text-slate-900 mb-3">
        Seguridad y prevención de fraude
      </h3>
      <ul class="text-slate-600 leading-relaxed list-disc list-inside space-y-2">
        {securityItems.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </article>

    <article
      class="flex flex-col p-8 rounded-2xl bg-slate-50 hover:bg-white border border-transparent hover:border-slate-200 hover:shadow-xl transition-all duration-300"
    >
      <div
        class="mb-6 flex size-12 shrink-0 items-center justify-center rounded-lg bg-[#040066]/10 text-[#040066]"
      >
        <ChartColumn class="size-6" />
      </div>
      <h3 class="text-xl font-bold text-slate-900 mb-3">
        Analíticas y control
      </h3>
      <ul class="text-slate-600 leading-relaxed list-disc list-inside space-y-2 grid grid-cols-1 md:grid-cols-2 gap-x-8">
        {analyticsItems.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </article>
  </div>
</section>
