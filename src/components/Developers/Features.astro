---
import {
  BarChart3,
  BookOpen,
  Shield,
} from "@lucide/astro";

const features = [
  {
    title: "SDKs completos",
    description:
      "Librerías oficiales para Node.js, Python, Ruby, PHP y Go para empezar en minutos.",
    icon: BookOpen,
    iconBg: "bg-blue-100 text-blue-600",
    badges: ["Node.js", "Python", "Go"],
  },
  {
    title: "Protección contra fraude",
    description:
      "Modelos de aprendizaje automático entrenados con miles de millones de datos para detectar fraude automáticamente.",
    icon: Shield,
    iconBg: "bg-indigo-100 text-indigo-600",
  },
  {
    title: "Analíticas detalladas",
    description:
      "Obtén información sobre tus ingresos, el comportamiento de los clientes y las tasas de éxito de pagos con nuestro panel.",
    icon: BarChart3,
    iconBg: "bg-orange-100 text-orange-600",
  },
];
---

<section
  class="my-16 lg:my-16 px-6 lg:px-16 max-w-[1440px] mx-auto w-full"
  aria-labelledby="features-heading"
>
  <div class="flex flex-col gap-6 text-center mb-16">
    <h2
      id="features-heading"
      class="text-slate-900 text-3xl font-black tracking-tight"
    >
      Todo lo que necesitas para crear flujos a medida
    </h2>
    <p class="text-slate-600 max-w-2xl mx-auto">
      Nuestra API está diseñada para ser intuitiva y potente, manejando la
      complejidad de los pagos para que te centres en tu producto.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {
      features.map((feature) => {
        const Icon = feature.icon;
        return (
          <article
            class="group flex flex-col p-8 rounded-2xl bg-slate-50 hover:bg-white border border-transparent hover:border-slate-200 hover:shadow-xl transition-all duration-300"
          >
            <div
              class={`mb-6 flex size-12 shrink-0 items-center justify-center rounded-lg ${feature.iconBg}`}
            >
              <Icon class="size-6" />
            </div>
          <h3 class="text-xl font-bold text-slate-900 mb-3">
            {feature.title}
          </h3>
          <p class="text-slate-600 leading-relaxed mb-6">
            {feature.description}
          </p>
          {feature.badges && (
            <div class="mt-auto flex flex-wrap gap-2">
              {feature.badges.map((badge) => (
                <span
                  class="rounded-md bg-slate-200/80 px-2.5 py-1 font-mono text-sm font-medium text-slate-700"
                >
                  {badge}
                </span>
              ))}
            </div>
          )}
          </article>
        );
      })
    }
  </div>
</section>
