---
import {
  ArrowRight,
  Check,
  Code2,
  Copy,
  FileText,
  FlaskConical,
  Webhook,
  Zap,
} from "@lucide/astro";
---

<section
  class="relative overflow-hidden bg-white px-4 pt-8 pb-12 md:px-10 md:pt-12 md:pb-18"
  aria-label="Developer First"
>
  <div class="relative z-10 mx-auto flex max-w-[1280px] flex-col">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <!-- Columna izquierda -->
      <div class="flex flex-col gap-8">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#040066]/10 w-fit"
        >
          <Code2 class="size-4 text-[#040066]" />
          <span
            class="text-[#040066] text-xs font-bold uppercase tracking-wider"
          >
            Primero el desarrollador
          </span>
        </div>

        <div class="flex flex-col gap-4">
          <h1
            class="text-slate-900 text-4xl lg:text-6xl font-black leading-[1.1] tracking-[-0.033em]"
          >
            Pagos potentes para aplicaciones modernas
          </h1>
          <p
            class="text-slate-600 text-lg lg:text-xl font-normal leading-relaxed max-w-[540px]"
          >
            Construido por ingenieros, para equipos técnicos que necesitan
            velocidad, control y estabilidad.
          </p>
          <p
            class="text-slate-600 text-lg lg:text-xl font-normal leading-relaxed max-w-[540px]"
          >
            Integra pagos sin fricciones con una API clara, consistente y
            preparada para escalar desde el primer día.
          </p>
        </div>

        <ul class="flex flex-col gap-4" role="list">
          <li class="flex items-start gap-4">
            <span
              class="mt-1 flex size-8 shrink-0 items-center justify-center rounded-full bg-green-100 text-green-700"
            >
              <Check class="size-5" />
            </span>
            <div>
              <h3 class="text-slate-900 font-bold text-lg">
                Claves API al instante
              </h3>
              <p class="text-slate-600 text-sm">
                Genera claves de producción y pruebas directamente desde tu
                panel.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span
              class="mt-1 flex size-8 shrink-0 items-center justify-center rounded-full bg-purple-100 text-purple-700"
            >
              <Webhook class="size-5" />
            </span>
            <div>
              <h3 class="text-slate-900 font-bold text-lg">
                Webhooks en tiempo real
              </h3>
              <p class="text-slate-600 text-sm">
                Recibe notificaciones instantáneas sobre eventos de pago.
              </p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span
              class="mt-1 flex size-8 shrink-0 items-center justify-center rounded-full bg-blue-100 text-blue-700"
            >
              <FlaskConical class="size-5" />
            </span>
            <div>
              <h3 class="text-slate-900 font-bold text-lg">
                Entorno sandbox completo
              </h3>
              <p class="text-slate-600 text-sm">
                Simula pagos y validaciones antes de producción.
              </p>
            </div>
          </li>
        </ul>

        <div class="flex flex-col gap-4 pt-4 lg:flex-row">
          <a
            href="https://sp-qa.supernova-payments.com/docs/api#/"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg h-12 px-6 bg-[#040066] hover:bg-[#03004a] transition-all shadow-lg shadow-[#040066]/20 text-white text-base font-bold tracking-[0.015em] lg:w-auto lg:whitespace-nowrap"
          >
            <FileText class="size-5 shrink-0" />
            <span>Descargar documentación técnica</span>
          </a>
          <a
            href="https://sp-qa.supernova-payments.com/docs/api#/"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg h-12 px-6 bg-white border border-slate-200 hover:border-[#040066]/50 hover:bg-slate-50 transition-all text-slate-900 text-base font-bold lg:w-auto lg:whitespace-nowrap"
          >
            <span>Ver referencia de la API</span>
            <ArrowRight class="size-5 shrink-0" />
          </a>
        </div>
      </div>

      <!-- Columna derecha: code block + latency card -->
      <div class="relative w-full">
        <div
          class="absolute -inset-4 bg-linear-to-r from-[#040066]/10 to-[#040066]/20 rounded-2xl blur-xl opacity-70"
          aria-hidden="true"
        >
        </div>
        <div
          class="relative bg-[#1e1e2e] rounded-xl shadow-2xl border border-slate-800 overflow-hidden font-mono text-sm leading-relaxed"
        >
          <div
            class="flex items-center justify-between px-4 py-3 bg-[#181825] border-b border-slate-700"
          >
            <div class="flex items-center gap-2">
              <span class="size-3 rounded-full bg-red-500"></span>
              <span class="size-3 rounded-full bg-yellow-500"></span>
              <span class="size-3 rounded-full bg-green-500"></span>
            </div>
            <span class="text-slate-400 text-xs"
              >Ejemplo de creación de pago: POST /v1/payments</span
            >
            <button
              type="button"
              class="text-slate-500 hover:text-white cursor-pointer p-1 rounded"
              aria-label="Copiar código"
            >
              <Copy class="size-4" />
            </button>
          </div>
          <div class="p-6 overflow-x-auto">
            <pre
              class="text-blue-300 m-0"
              aria-label="Ejemplo de petición cURL"><code><span class="text-purple-400">curl</span> https://api.supernova.com/v1/payments \
  <span class="text-orange-400">-u</span> sk_test_your_api_key_here: \
  <span class="text-orange-400">-d</span> <span class="text-green-400">amount</span>=2000 \
  <span class="text-orange-400">-d</span> <span class="text-green-400">currency</span>=usd \
  <span class="text-orange-400">-d</span> <span class="text-green-400">payment_method</span>=card \
  <span class="text-orange-400">-d</span> <span class="text-green-400">confirmation_method</span>=automatic \
  <span class="text-orange-400">-d</span> <span class="text-green-400">description</span>="Software Subscription"</code></pre>
            <div class="mt-6 pt-6 border-t border-slate-700/50">
              <div class="text-slate-500 mb-2">// Respuesta</div>
              <pre
                class="text-slate-300 m-0"
                aria-label="Ejemplo de respuesta JSON"><code>{'{'}
  <span class="text-blue-300">"id"</span>: <span class="text-green-400">"pay_3MtwBwLkdIwHu7ix28a3tqPa"</span>,
  <span class="text-blue-300">"object"</span>: <span class="text-green-400">"payment"</span>,
  <span class="text-blue-300">"amount"</span>: <span class="text-yellow-300">2000</span>,
  <span class="text-blue-300">"currency"</span>: <span class="text-green-400">"usd"</span>,
  <span class="text-blue-300">"status"</span>: <span class="text-green-400">"succeeded"</span>
{'}'}</code></pre>
            </div>
          </div>
        </div>

        <!-- Tarjeta flotante Latency -->
        <div
          class="absolute -bottom-6 -right-6 z-10 hidden lg:block"
          aria-label="Latencia media"
        >
          <div
            class="bg-white p-4 rounded-lg shadow-xl border border-slate-100 max-w-[240px]"
          >
            <div class="flex items-center gap-3 mb-2">
              <span class="bg-green-100 p-1.5 rounded-full text-green-600">
                <Zap class="size-4" />
              </span>
              <span class="text-xs font-bold text-slate-500 uppercase">
                Rendimiento optimizado
              </span>
            </div>
            <p class="text-sm text-slate-600 mt-1">
              Infraestructura diseñada para baja latencia y alta disponibilidad.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
