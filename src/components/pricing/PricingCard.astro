---
import { CheckCircle } from "@lucide/astro";

const features = [
  "Integración de terminal",
  "Sincronización en tiempo real",
  "Soporte prioritario 24/7",
  "Encriptación segura",
];
---

<section class="px-6 pb-24" aria-labelledby="pos-plan-heading">
  <div class="mx-auto max-w-5xl">
    <div
      class="group relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-8 shadow-xl shadow-slate-200/50 transition-all hover:shadow-2xl hover:shadow-[#040066]/5 md:flex md:items-center md:gap-12 md:p-12"
    >
      <div
        class="absolute -mr-16 -mt-16 top-0 right-0 h-64 w-64 rounded-full bg-[#040066]/5 blur-3xl transition-colors group-hover:bg-[#040066]/10"
        aria-hidden="true"
      >
      </div>
      <div class="flex-1">
        <div
          class="mb-6 inline-flex items-center rounded-full bg-[#040066]/10 px-4 py-1 text-sm font-bold text-[#040066]"
        >
          Más popular
        </div>
        <h3
          id="pos-plan-heading"
          class="mb-2 text-3xl font-bold text-slate-900"
        >
          Servicio POS
        </h3>
        <p class="mb-8 text-slate-600">
          Solución completa de hardware y software para retail físico y
          hostelería.
        </p>
        <div class="grid gap-4 md:grid-cols-2">
          {
            features.map((feature) => (
              <div class="flex items-center gap-3 text-slate-700">
                <CheckCircle class="size-5 shrink-0 text-[#040066]" />
                <span class="text-sm font-medium">{feature}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div
        class="mt-10 flex flex-col items-center justify-center rounded-xl bg-slate-50 p-8 text-center md:mt-0 md:w-80"
      >
        <div class="mb-1 text-sm font-medium text-slate-500 line-through">
          $350 USD
        </div>
        <div class="flex items-baseline gap-1 text-slate-900">
          <span class="text-5xl font-black">$300</span>
          <span class="text-sm font-bold text-slate-500">USD</span>
        </div>
        <div class="mt-2 text-sm font-bold text-[#040066]">+ $10 USD/mes</div>
        <p class="mt-1 text-xs text-slate-400">Cuota de conectividad</p>
        <a
          href="/merchants"
          class="mt-8 w-full rounded-xl bg-[#040066] py-3 font-bold text-white shadow-lg shadow-[#040066]/20 transition-transform hover:scale-[1.02]"
        >
          Elegir plan POS
        </a>
      <p class="mt-3 text-sm font-semibold text-slate-600">
        4.5% por transacción
      </p>
    </div>
  </div>
</section>
