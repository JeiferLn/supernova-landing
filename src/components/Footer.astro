---
import { AtSign, Globe, MessageCircle } from "@lucide/astro";

const products = [
  { label: "Payments", href: "/" },
  { label: "Billing", href: "/" },
  { label: "Connect", href: "/" },
  { label: "Payouts", href: "/" },
];

const developers = [
  { label: "Documentation", href: "/" },
  { label: "API Reference", href: "/" },
  { label: "API Status", href: "/" },
  { label: "SDKs", href: "/" },
];

const company = [
  { label: "About", href: "/" },
  { label: "Customers", href: "/" },
  { label: "Careers", href: "/" },
  { label: "Contact", href: "/" },
];

const socialLinks = [
  { href: "/", label: "Website", icon: Globe },
  { href: "/", label: "Email", icon: AtSign },
  { href: "/", label: "Chat", icon: MessageCircle },
];
---

<footer class="w-full bg-white" role="contentinfo">
  <div class="w-full mx-auto px-6 py-12 sm:px-6 lg:py-14">
    <!-- Sección superior: columnas -->
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10">
      <!-- Columna 1: Brand + descripción + iconos -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-[#1e3a5f] font-bold text-lg no-underline"
          aria-label="Supernova Payments - Inicio"
        >
          <span class="flex shrink-0">
            <svg
              width="28"
              height="28"
              viewBox="0 0 32 32"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <circle cx="16" cy="16" r="14" fill="#1e3a5f"></circle>
              <path d="M16 10l6 10H10l6-10z" fill="#5b8fc9"></path>
            </svg>
          </span>
          <span>Supernova</span>
        </a>
        <p class="mt-3 text-sm text-slate-500 leading-relaxed">
          Empowering the internet economy with modern payment infrastructure.
        </p>
        <div class="mt-4 flex items-center gap-4">
          {
            socialLinks.map(({ href, label, icon: Icon }) => (
              <a
                href={href}
                class="text-slate-400 hover:text-[#1e3a5f] transition-colors"
                aria-label={label}
              >
                <Icon size={20} />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Columna 2: Products -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">
          Products
        </h3>
        <ul class="mt-4 list-none p-0 m-0 space-y-2">
          {
            products.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="text-sm text-slate-500 no-underline hover:text-[#1e3a5f] transition-colors"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 3: Developers -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">
          Developers
        </h3>
        <ul class="mt-4 list-none p-0 m-0 space-y-2">
          {
            developers.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="text-sm text-slate-500 no-underline hover:text-[#1e3a5f] transition-colors"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Columna 4: Company -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">
          Company
        </h3>
        <ul class="mt-4 list-none p-0 m-0 space-y-2">
          {
            company.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="text-sm text-slate-500 no-underline hover:text-[#1e3a5f] transition-colors"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Sección inferior: copyright + enlaces legales -->
    <div
      class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-slate-200 pt-8 sm:flex-row"
    >
      <p class="text-xs text-slate-400 order-2 sm:order-1">
        © 2023 Supernova Payments Inc.
      </p>
      <div
        class="flex flex-wrap items-center justify-center gap-x-6 gap-y-1 text-xs text-slate-400 order-1 sm:order-2"
      >
        <a href="/" class="no-underline hover:text-[#1e3a5f] transition-colors">
          Privacy & Terms
        </a>
        <a href="/" class="no-underline hover:text-[#1e3a5f] transition-colors">
          Site Map
        </a>
        <a href="/" class="no-underline hover:text-[#1e3a5f] transition-colors">
          Cookie Settings
        </a>
      </div>
    </div>
  </div>
</footer>
