---
import { ArrowRight, CheckCircle, ChevronDown } from "@lucide/astro";

const countries = [
  "Estados Unidos",
  "Reino Unido",
  "Canadá",
  "Alemania",
  "Francia",
  "Australia",
  "Japón",
];

const businessTypes = [
  "Comercio electrónico / Retail",
  "SaaS / Bienes digitales",
  "Marketplace",
  "Viajes y hostelería",
  "Videojuegos",
  "Otro",
];
---

<div class="flex flex-col lg:w-2/3">
  <div
    class="rounded-2xl border border-[#e7e6f4] bg-white p-6 shadow-sm sm:p-10"
  >
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-slate-900">
        Conviértete en socio comercio
      </h2>
      <p class="mt-2 text-[#4946a0]">
        Completa el formulario y nuestro equipo te responderá en breve.
      </p>
    </div>

    <form class="space-y-5" action="#" method="post">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-semibold text-slate-900">Nombre completo</span>
          <input
            type="text"
            name="fullName"
            placeholder="Juan Pérez"
            class="w-full rounded-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 shadow-sm transition-all placeholder:text-gray-400 focus:border-[#040167] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040167]"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-semibold text-slate-900">Nombre de la empresa</span>
          <input
            type="text"
            name="company"
            placeholder="Supernova S.L."
            class="w-full rounded-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 shadow-sm transition-all placeholder:text-gray-400 focus:border-[#040167] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040167]"
          />
        </label>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-semibold text-slate-900">Correo laboral</span>
          <input
            type="email"
            name="email"
            placeholder="nombre@empresa.com"
            class="w-full rounded-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 shadow-sm transition-all placeholder:text-gray-400 focus:border-[#040167] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040167]"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-semibold text-slate-900">Teléfono</span>
          <div class="flex rounded-lg shadow-sm">
            <select
              name="countryCode"
              class="w-[80px] rounded-l-lg border border-r-0 border-gray-200 bg-gray-50/50 px-3 py-3 text-sm text-slate-900 transition-all focus:border-[#040167] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040167]"
            >
              <option value="US">US</option>
              <option value="UK">UK</option>
              <option value="CA">CA</option>
              <option value="EU">EU</option>
            </select>
            <input
              type="tel"
              name="phone"
              placeholder="+1 (555) 000-0000"
              class="flex-1 rounded-r-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 transition-all placeholder:text-gray-400 focus:border-[#040167] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040167]"
            />
          </div>
        </label>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-semibold text-slate-900">
            País de registro
          </span>
          <div class="relative">
            <select
              name="country"
              class="w-full appearance-none rounded-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 shadow-sm transition-all focus:border-[#040167] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040167]"
            >
              <option value="" disabled selected>Selecciona un país</option>
              {countries.map((c) => (
                <option value={c}>{c}</option>
              ))}
            </select>
            <span
              class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-gray-500"
              aria-hidden="true"
            >
              <ChevronDown class="size-5" />
            </span>
          </div>
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-semibold text-slate-900">
            Tipo de negocio
          </span>
          <div class="relative">
            <select
              name="businessType"
              class="w-full appearance-none rounded-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 shadow-sm transition-all focus:border-[#040167] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040167]"
            >
              <option value="" disabled selected>Selecciona el tipo de negocio</option>
              {businessTypes.map((type) => (
                <option value={type}>{type}</option>
              ))}
            </select>
            <span
              class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-gray-500"
              aria-hidden="true"
            >
              <ChevronDown class="size-5" />
            </span>
          </div>
        </label>
      </div>

      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-semibold text-slate-900">Mensaje</span>
        <textarea
          name="message"
          rows="4"
          placeholder="Cuéntanos más sobre las necesidades de tu negocio..."
          class="w-full resize-none rounded-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 shadow-sm transition-all placeholder:text-gray-400 focus:border-[#040167] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040167]"
        />
      </label>

      <div class="pt-2">
        <button
          type="submit"
          class="group flex w-full items-center justify-center gap-2 rounded-lg bg-[#040167] px-6 py-4 text-base font-bold text-white shadow-md transition-all hover:bg-[#03004a] hover:shadow-lg active:scale-[0.98]"
        >
          Conviértete en comercio
          <ArrowRight
            class="size-5 shrink-0 transition-transform group-hover:translate-x-1"
          />
        </button>
      </div>

      <div class="flex items-center justify-center gap-2 pt-2">
        <CheckCircle class="size-5 shrink-0 text-[#4946a0]" />
        <p class="text-center text-xs text-[#4946a0]">
          Tu solicitud se enviará a{" "}
          <span class="font-medium text-slate-900"
            >pgateway@supernova-payments.com</span
          >
        </p>
      </div>
    </form>
  </div>
</div>
