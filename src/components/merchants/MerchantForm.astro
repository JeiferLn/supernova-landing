---
import { ArrowRight, CheckCircle, ChevronDown } from "@lucide/astro";

const countries = [
  "Estados Unidos",
  "Reino Unido",
  "Canadá",
  "Alemania",
  "Francia",
  "Australia",
  "Japón",
];

const businessTypes = [
  "Comercio electrónico / Retail",
  "SaaS / Bienes digitales",
  "Marketplace",
  "Viajes y hostelería",
  "Videojuegos",
  "Otro",
];
---

<div class="flex flex-col lg:w-2/3">
  <div
    class="rounded-2xl border border-[#040066]/15 bg-white p-6 shadow-sm sm:p-10"
  >
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-slate-900">
        Conviértete en socio comerciante
      </h2>
      <p class="mt-2 text-[#4040a0]">
        Completa el formulario y nuestro equipo te responderá en breve.
      </p>
    </div>

    <form class="space-y-5" action="#" method="post">
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-semibold text-slate-900"
            >Nombre completo</span
          >
          <input
            type="text"
            name="fullName"
            placeholder="Juan Pérez"
            class="w-full rounded-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 shadow-sm transition-all placeholder:text-gray-400 focus:border-[#040066] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040066]"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-semibold text-slate-900"
            >Nombre de la empresa</span
          >
          <input
            type="text"
            name="company"
            placeholder="Supernova S.L."
            class="w-full rounded-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 shadow-sm transition-all placeholder:text-gray-400 focus:border-[#040066] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040066]"
          />
        </label>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-semibold text-slate-900"
            >Correo laboral</span
          >
          <input
            type="email"
            name="email"
            placeholder="nombre@empresa.com"
            class="w-full rounded-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 shadow-sm transition-all placeholder:text-gray-400 focus:border-[#040066] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040066]"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-semibold text-slate-900">Teléfono</span>
          <div
            class="flex rounded-lg shadow-sm border border-gray-200 overflow-hidden focus-within:border-[#040066] focus-within:ring-1 focus-within:ring-[#040066]"
          >
            <select
              id="phonePrefix"
              aria-label="Prefijo de país"
              class="min-w-[96px] shrink-0 border-r border-gray-200 bg-gray-50/50 pl-3 pr-10 py-3 text-sm text-slate-900 transition-all focus:border-[#040066] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040066] [&::-ms-expand]:hidden appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2364748b%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m6%209%206%206%206-6%22%2F%3E%3C%2Fsvg%3E')] bg-size-[1.25rem] bg-position-[right_0.5rem_center] bg-no-repeat"
            >
              <option value="+53">CU</option>
              <option value="+57">CO</option>
            </select>
            <div class="flex flex-1 min-w-0 bg-gray-50/50">
              <span
                id="phonePrefixDisplay"
                class="flex items-center pl-4 pr-1 py-3 text-slate-900 bg-transparent shrink-0 select-none pointer-events-none"
                aria-hidden="true"
              >
                +53
              </span>
              <input
                type="tel"
                id="phoneNumber"
                placeholder="5 123 4567"
                inputmode="numeric"
                pattern="[0-9\s\-]*"
                class="flex-1 min-w-0 border-0 bg-transparent pl-0 pr-4 py-3 text-slate-900 placeholder:text-gray-400 focus:outline-none focus:ring-0"
              />
            </div>
            <input type="hidden" name="phone" id="phoneFull" />
          </div>
        </label>

        <script>
          const prefixSelect = document.getElementById(
            "phonePrefix",
          ) as HTMLSelectElement;
          const prefixDisplay = document.getElementById(
            "phonePrefixDisplay",
          ) as HTMLSpanElement;
          const phoneInput = document.getElementById(
            "phoneNumber",
          ) as HTMLInputElement;
          const phoneFull = document.getElementById(
            "phoneFull",
          ) as HTMLInputElement;

          function updatePrefix() {
            const prefix = prefixSelect.value;
            prefixDisplay.textContent = prefix;
            phoneInput.placeholder =
              prefix === "+53" ? "5 123 4567" : "300 123 4567";
          }

          function updateFullPhone() {
            const prefix = prefixSelect.value;
            const number = phoneInput.value
              .replace(/\s/g, "")
              .replace(/-/g, "");
            phoneFull.value = number ? `${prefix}${number}` : "";
          }

          prefixSelect?.addEventListener("change", updatePrefix);
          phoneInput?.addEventListener("input", updateFullPhone);
          phoneInput?.addEventListener("blur", updateFullPhone);

          document
            .querySelector("form")
            ?.addEventListener("submit", updateFullPhone);

          updatePrefix();
        </script>
      </div>

      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-semibold text-slate-900">
            País de registro
          </span>
          <div class="relative">
            <select
              name="country"
              class="w-full appearance-none rounded-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 shadow-sm transition-all focus:border-[#040066] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040066]"
            >
              <option value="" disabled selected>Selecciona un país</option>
              {countries.map((c) => <option value={c}>{c}</option>)}
            </select>
            <span
              class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-gray-500"
              aria-hidden="true"
            >
              <ChevronDown class="size-5" />
            </span>
          </div>
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-sm font-semibold text-slate-900">
            Tipo de negocio
          </span>
          <div class="relative">
            <select
              name="businessType"
              class="w-full appearance-none rounded-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 shadow-sm transition-all focus:border-[#040066] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040066]"
            >
              <option value="" disabled selected
                >Selecciona el tipo de negocio</option
              >
              {
                businessTypes.map((type) => (
                  <option value={type}>{type}</option>
                ))
              }
            </select>
            <span
              class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-gray-500"
              aria-hidden="true"
            >
              <ChevronDown class="size-5" />
            </span>
          </div>
        </label>
      </div>

      <label class="flex flex-col gap-1.5">
        <span class="text-sm font-semibold text-slate-900">Mensaje</span>
        <textarea
          name="message"
          rows="4"
          placeholder="Cuéntanos más sobre las necesidades de tu negocio..."
          class="w-full resize-none rounded-lg border border-gray-200 bg-gray-50/50 px-4 py-3 text-slate-900 shadow-sm transition-all placeholder:text-gray-400 focus:border-[#040066] focus:bg-white focus:outline-none focus:ring-1 focus:ring-[#040066]"
        ></textarea>
      </label>

      <div class="pt-2">
        <button
          type="submit"
          class="group flex w-full items-center justify-center gap-2 rounded-lg bg-[#040066] px-6 py-4 text-base font-bold text-white shadow-md transition-all hover:bg-[#03004a] hover:shadow-lg active:scale-[0.98]"
        >
          Conviértete en comerciante
          <ArrowRight
            class="size-5 shrink-0 transition-transform group-hover:translate-x-1"
          />
        </button>
      </div>

      <div class="flex items-center justify-center gap-2 pt-2">
        <CheckCircle class="size-5 shrink-0 text-[#4040a0]" />
        <p class="text-center text-xs text-[#4040a0]">
          Tu solicitud se enviará a{" "}
          <span class="font-medium text-slate-900"
            >pgateway@supernova-payments.com</span
          >
        </p>
      </div>
    </form>
  </div>
</div>
