---
import { CreditCard, Globe, Headphones } from "@lucide/astro";

const features = [
  {
    title: "Tarifas competitivas",
    description: "Comisiones de transacción líderes en el sector, adaptadas a tu volumen.",
    icon: CreditCard,
  },
  {
    title: "Alcance global",
    description: "Acepta pagos en más de 135 monedas en todo el mundo.",
    icon: Globe,
  },
  {
    title: "Soporte 24/7",
    description: "Gestores de cuenta dedicados y equipos de soporte técnico.",
    icon: Headphones,
  },
];
---

<div class="flex flex-col gap-6 lg:w-1/3 lg:pt-10">
  <div class="space-y-4">
    <span
      class="inline-flex items-center rounded-full bg-[#040066]/10 px-3 py-1 text-sm font-medium text-[#040066] ring-1 ring-inset ring-[#040066]/20"
    >
      Socios de comercio
    </span>
    <h1
      class="text-slate-900 text-4xl font-black leading-[1.1] tracking-[-0.033em] lg:text-5xl"
    >
      Escala tu negocio a nivel global con Supernova.
    </h1>
    <p class="text-[#4040a0] text-lg font-normal leading-relaxed">
      Únete a miles de comercios que confían en Supernova Payments para un
      procesamiento de transacciones seguro, rápido y fiable. Empieza hoy.
    </p>
  </div>

  <div class="mt-8 space-y-6">
    {
      features.map((feature) => {
        const Icon = feature.icon;
        return (
          <div class="flex items-start gap-4">
            <div
              class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-[#040066]/15 bg-[#040066]/5 text-[#040066]"
            >
              <Icon class="size-5" />
            </div>
            <div>
              <h3 class="font-bold text-slate-900">{feature.title}</h3>
              <p class="mt-1 text-sm text-[#4040a0]">{feature.description}</p>
            </div>
          </div>
        );
      })
    }
  </div>
</div>
