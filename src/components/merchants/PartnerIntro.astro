---
import { CreditCard, Globe, Headphones } from "@lucide/astro";

const features = [
  {
    title: "Competitive Rates",
    description: "Industry-leading transaction fees tailored to your volume.",
    icon: CreditCard,
  },
  {
    title: "Global Reach",
    description: "Accept payments in over 135 currencies worldwide.",
    icon: Globe,
  },
  {
    title: "24/7 Support",
    description: "Dedicated account managers and technical support teams.",
    icon: Headphones,
  },
];
---

<div class="flex flex-col gap-6 lg:w-1/3 lg:pt-10">
  <div class="space-y-4">
    <span
      class="inline-flex items-center rounded-full bg-[#040167]/10 px-3 py-1 text-sm font-medium text-[#040167] ring-1 ring-inset ring-[#040167]/20"
    >
      Merchant Partners
    </span>
    <h1
      class="text-slate-900 text-4xl font-black leading-[1.1] tracking-[-0.033em] lg:text-5xl"
    >
      Scale your business globally with Supernova.
    </h1>
    <p class="text-[#4946a0] text-lg font-normal leading-relaxed">
      Join thousands of merchants who trust Supernova Payments for secure,
      fast, and reliable transaction processing. Get started today.
    </p>
  </div>

  <div class="mt-8 space-y-6">
    {
      features.map((feature) => {
        const Icon = feature.icon;
        return (
          <div class="flex items-start gap-4">
            <div
              class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-[#e7e6f4] bg-[#f8f8fc] text-[#040167]"
            >
              <Icon class="size-5" />
            </div>
            <div>
              <h3 class="font-bold text-slate-900">{feature.title}</h3>
              <p class="mt-1 text-sm text-[#4946a0]">{feature.description}</p>
            </div>
          </div>
        );
      })
    }
  </div>
</div>
