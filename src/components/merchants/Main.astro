---
import MerchantForm from "./MerchantForm.astro";
import PartnerIntro from "./PartnerIntro.astro";
---

<main
  class="relative flex grow flex-col bg-white px-4 py-10 md:px-10 md:py-12"
  aria-label="Merchant Partners"
>
  <!-- Elementos decorativos de fondo -->
  <div
    class="fixed top-20 left-0 -z-10 size-[500px] rounded-full bg-[#040167]/5 blur-[100px]"
    aria-hidden="true"
  />
  <div
    class="fixed bottom-0 right-0 -z-10 size-[500px] rounded-full bg-blue-100/30 blur-[100px]"
    aria-hidden="true"
  />

  <div class="relative z-10 mx-auto flex w-full max-w-[1280px] flex-col gap-12 lg:flex-row lg:gap-24">
    <PartnerIntro />
    <MerchantForm />
  </div>
</main>
